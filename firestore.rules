rules_version = '2';

// ============================================================
// REGRAS DE PROTÓTIPO — qualquer pessoa com o link do app
// consegue ler e escrever. Ótimo para testar rápido, mas
// ANTES de usar com dados reais da congregação, troque por
// autenticação (ver README, seção "Segurança").
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

